# Copiar a .env.local y completar con valores reales. Nunca commitear .env.local.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (tipo "Web application", redirect URI: http://localhost:3000/api/auth/callback/google).
# GOOGLE_CLIENT_ID debe ser EXACTAMENTE el mismo valor que backend/.env (GOOGLE_CLIENT_ID) —
# el backend verifica el id_token contra esa audiencia.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
