# Copiar a .env y completar con valores reales. Nunca commitear .env.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/techstore?sslmode=require

# --- Redis (Upstash REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Google OAuth ---
# Mismo Client ID que frontend/.env.local (GOOGLE_CLIENT_ID) — el backend solo
# verifica el id_token (firma + audiencia), no necesita el client secret.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=

# --- Stripe ---
# https://dashboard.stripe.com/test/apikeys (modo test)
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/test/webhooks — o `stripe listen --print-secret` en local
STRIPE_WEBHOOK_SECRET=

# --- Checkout ---
STOCK_HOLD_TTL_MINUTES=15

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- App ---
PORT=3001
NODE_ENV=development
